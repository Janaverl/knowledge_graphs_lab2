@prefix this: <https://janaverl.github.io/knowledge_graphs_lab2/vocabulary.ttl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<#name> 
    a               rdf:Property ;
    rdfs:label      "name"@en ;
    rdfs:comment    "a word or set of words by which a person, a thing or a place is known or addressed"@en ;
    rdfs:domain     rdfs:Resource ;
    rdfs:range      rdfs:Literal .

<#Person> 
    a               rdf:Class ;
    rdfs:label      "person"@en ;
    rdfs:comment    "a human being"@en .

<#Student> 
    a               rdf:Class ;
    rdfs:subClassOf this:Person ;
    rdfs:label      "student"@en ;
    rdfs:comment    "a person who enrolls in an educational program or course"@en .

<#student-enrolment-type> 
    a               rdf:Property ;
    rdfs:label      "student enrolment type"@en ;
    rdfs:comment    "the category under which a student is officially registered at an educational institution"@en ;
    rdfs:domain     this:Student ;
    rdfs:range      rdfs:Resource .

<#micro-credential-student> 
    a               rdfs:Class ;
    rdfs:label      "micro-credential student"@en ;
    rdfs:comment    "a student who enrolls in a short, focused educational program designed to build a specific skill or competency"@en .

<#e-mail> 
    a               rdf:Property ;
    rdfs:label      "e-mail"@en ;
    rdfs:comment    "pro memory"@en ;
    rdfs:domain     rdfs:Resource ;
    rdfs:range      rdfs:Literal .

<#favorite-drink> 
    a               rdf:Property ;
    rdfs:label      "favorite drink"@en ;
    rdfs:comment    "pro memory"@en ;
    rdfs:domain     rdfs:Resource ;
    rdfs:range      rdfs:Resource .

<#coffee> 
    a               rdfs:Class;
    rdfs:label      "coffee"@en ;
    rdfs:comment    "pro memory"@en .

<#hobby> 
    a               rdf:Property ;
    rdfs:label      "hobby"@en ;
    rdfs:comment    "pro memory"@en ;
    rdfs:domain     rdfs:Resource ;
    rdfs:range      rdfs:Resource .

<#running> 
    a               rdfs:Class;
    rdfs:label      "running"@en ;
    rdfs:comment    "pro memory"@en .

<#location> 
    a               rdf:Property ;
    rdfs:label      "location"@en ;
    rdfs:comment    "pro memory"@en ;
    rdfs:domain     rdfs:Resource ;
    rdfs:range      rdfs:Resource .

<#Ghent> 
    a               rdfs:Class;
    rdfs:label      "Ghent"@en ;
    rdfs:comment    "pro memory"@en .

<#knows> 
    a               rdf:Property ;
    rdfs:label      "knows"@en ;
    rdfs:comment    "pro memory"@en ;
    rdfs:domain     rdfs:Resource ;
    rdfs:range      rdfs:Resource .