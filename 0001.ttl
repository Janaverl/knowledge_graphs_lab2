# @prefix this: <https://janaverl.github.io/knowledge_graphs_lab2/0001.ttl#> .
@base <https://janaverl.github.io/knowledge_graphs_lab2/0001.ttl> .
@prefix voc: <https://janaverl.github.io/knowledge_graphs_lab2/vocabulary.ttl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<#me>
    voc:name                        "Jana Verlinde"^^xsd:string ;
    a                               voc:Person ;
    a                               voc:Student ;
    voc:student-enrolment-type      voc:Micro-credential-student ;
    voc:e-mail                      "jana.verlinde@ugent.be"^^xsd:string ;
    voc:favorite-drink              voc:Coffee ;
    voc:hobby                       voc:Running ;
    voc:knows                       <https://vucis.github.io/data.ttl#me>  ,
                                    <https://lander6.github.io/knowledge-graph-assignment/data.ttl#lander> .

<#jana>
    owl:sameAs                     <#me> .